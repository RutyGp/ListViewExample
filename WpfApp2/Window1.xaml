<Window x:Class="WpfApp2.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="20" FlowDirection="RightToLeft">
            <TextBlock Text="רשימת סרטים (אובייקטים מורכבים):" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

            <ListView x:Name="MoviesListView" 
                      SelectionChanged="MoviesListView_SelectionChanged" >
              
          

            <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">

                            <TextBlock Text="{Binding Title}" 
                              FontWeight="Bold" 
                              Foreground="DarkBlue" Width="150" />

                            <TextBlock Text="{Binding Genre}" 
                               Foreground="Gray" 
                               Width="100" />

                            <TextBlock Text="{Binding Year}" Width="80" />

                            <CheckBox />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>


    </Grid>
</Window>
