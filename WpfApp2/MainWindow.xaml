<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
         <StackPanel Margin="20" FlowDirection="RightToLeft">

            <Button Content=" window1" Click="Next" Width="60"/>
            <Button Content=" window2" Click="Next2" Width="60"/>
            <Button Content=" ValueconverterWindow" Click="Next3" Width="60"/>
            

            <TextBlock Text="רשימת ערים (טיפוס String):" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />

            <ListView x:Name="SimpleListView" Height="150" />

            <StackPanel Orientation="Horizontal">
                <TextBox Width="100" FontSize="30" Background="Goldenrod" x:Name="newCity" Margin="0,0,50,0"/>
                <Button Content="הוסף" Width="50"  Click="AddCity"/>

            </StackPanel>

            
             
             
            <ScrollViewer Height="200"  >
                <ListView x:Name="years"/>
            </ScrollViewer>


           
        </StackPanel>


    </Grid>
</Window>
