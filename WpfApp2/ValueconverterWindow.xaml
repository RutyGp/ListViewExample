<Window x:Class="WpfApp2.ValueconverterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2.MyConvertors"
        mc:Ignorable="d"
        Title="ValueconverterWindow" Height="450" Width="800">

    <Window.Resources>
        <local:StockToVisibilityConverter x:Key="StockConverter"/>
        <local:PriceToCurrencyConverter x:Key="CurrencyConverter" />
        <local:BoolToColorConverter x:Key="MyColorConverter"/>

       
            <local:DateFormatConverter x:Key="DateConverter"/>
            <local:DaysRemainingConverter x:Key="DaysConverter"/>
            <local:ExpiredToRowColorConverter x:Key="RowColorConverter"/>
        </Window.Resources>
        <StackPanel>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <CheckBox x:Name="UrgentCheckBox" Content="האם דחוף?" Margin="0,0,0,10"/>

            <TextBlock Text="זוהי הודעת התראה חשובה!" 
               FontSize="16" 
               FontWeight="Bold"
               Foreground="{Binding ElementName=UrgentCheckBox, Path=IsChecked, Converter={StaticResource MyColorConverter}}" />

            
               
                       


        </StackPanel>
        <StackPanel Margin="20" FlowDirection="RightToLeft">
            <Label Content="הכנס כמות במלאי:" />
            <TextBox x:Name="StockInputTextBox" Text="5" Width="100"   
             HorizontalAlignment="Right" Margin="0,0,0,10"/>

            <TextBlock Text="⚠️ שים לב: המוצר אזל מהמלאי!" 
               Foreground="Red" 
               FontWeight="Bold" 
               FontSize="16"
               Visibility="{Binding ElementName=StockInputTextBox, 
                           Path=Text,
                           Converter={StaticResource 
                               StockConverter}}" />
        </StackPanel>


        <StackPanel Margin="20" FlowDirection="RightToLeft">
            <Slider x:Name="PriceSlider" Minimum="0" Maximum="10000"   
                         Value="1500" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="המחיר שנבחר: " FontSize="14"/>
                <TextBlock Text="{Binding ElementName=PriceSlider,  Path=Value, 
                      Converter={StaticResource CurrencyConverter}}" />
            </StackPanel>
        </StackPanel>




        <Grid Margin="15">
            <ListView ItemsSource="{Binding Products}">

                 <!--עיצוב השורה כולה: צביעה באדום אם פג התוקף--> 
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" 
                            Value="{Binding ExpirationDate, Converter={StaticResource RowColorConverter}}" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.View>
                    <GridView>
                        <!-- שם המוצר -->
                        <GridViewColumn Header="שם המוצר" Width="130" DisplayMemberBinding="{Binding Name}" />

                        <!-- מלאי -->
                        <GridViewColumn Header="מלאי" Width="60" DisplayMemberBinding="{Binding Stock}" />

                        <!-- תאריך ייצור בפורמט אירופאי (ברירת מחדל) -->
                        <GridViewColumn Header="ייצור (אירופאי)" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ManufactureDate, Converter={StaticResource DateConverter}, ConverterParameter=EU}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- תאריך ייצור בפורמט אמריקאי -->
                        <GridViewColumn Header="ייצור (אמריקאי)" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ManufactureDate, Converter={StaticResource DateConverter}, ConverterParameter=US}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- ימים שנותרו עד לתפוגה -->
                        <GridViewColumn Header="ימים לתפוגה" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpirationDate, Converter={StaticResource DaysConverter}}" 
                                           FontWeight="Bold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

        </Grid>

    </StackPanel>










</Window>
